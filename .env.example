DJANGO_SETTINGS_MODULE=clinic.settings_production
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_HSTS_SECONDS=31536000

# Production database: Liara PostgreSQL provides these variables.
POSTGRESQL_DB_HOST=replace-with-liara-host
POSTGRESQL_DB_PORT=5432
POSTGRESQL_DB_USER=replace-with-liara-user
POSTGRESQL_DB_PASS=replace-with-liara-password
POSTGRESQL_DB_NAME=replace-with-liara-database

# Liara Disk mount path for uploaded media.
MEDIA_ROOT=/app/media
